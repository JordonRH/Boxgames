# No credentials are needed by the game itself. Never commit your real .env.
PUBLIC_ORIGIN=https://boxgame.jrhtechservices.party
ALLOWED_ORIGINS=http://127.0.0.1:8100,http://localhost:8100
BIND_ADDRESS=127.0.0.1
HOST_PORT=8100
BOXGAME_IMAGE=boxgame:local
MAX_ROOMS=100
MAX_CONNECTIONS=1000
CONNECTIONS_PER_NETWORK=100
ROOMS_PER_NETWORK=5
# Empty means direct clients; forwarded client addresses are ignored.
# Set ONLY exact immediate proxy IPs after the operator confirms the topology.
TRUSTED_PROXY_IPS=
TRUST_CF_CONNECTING_IP=false
